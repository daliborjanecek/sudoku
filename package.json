{
  "name": "sudoku-web-component",
  "version": "1.0.0",
  "description": "Embeddable Sudoku widget as a native Web Component",
  "type": "module",
  "main": "dist/sudoku.js",
  "module": "dist/sudoku.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^20.10.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  }
}
